{
  "schema": "gate0-vps-reliability-corpus-1.0",
  "claim_limit": "Offline deterministic fault-oracle validation only; this is not VPS run evidence or trading authorization.",
  "scenarios": [
    {
      "id": "RVM-001-clean-startup-and-sample",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000}
      ],
      "expected": ["HEALTHY:OK","HEALTHY:OK"]
    },
    {
      "id": "RVM-002-protection-guard-fails-before-baseline",
      "frames": [
        {"event":"STARTUP","tradeapi_disabled":false},
        {"event":"STARTUP","tradeapi_disabled":true}
      ],
      "expected": ["SAFE_STOP:EXTERNAL_PYTHON_TRADING_NOT_DISABLED","SAFE_STOP:SAFE_STOP_LATCHED"]
    },
    {
      "id": "RVM-003-package-manifest-failure-latches",
      "frames": [{"event":"STARTUP","manifest_verified":false}],
      "expected": ["SAFE_STOP:PACKAGE_MANIFEST_UNVERIFIED"]
    },
    {
      "id": "RVM-004-static-verifier-failure-latches",
      "frames": [{"event":"STARTUP","static_verifier_pass":false}],
      "expected": ["SAFE_STOP:STATIC_VERIFIER_FAILED"]
    },
    {
      "id": "RVM-005-durable-write-failure-latches",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"write_ok":false},
        {"event":"SAMPLE","sequence":2,"monotonic_ms":3000}
      ],
      "expected": ["HEALTHY:OK","SAFE_STOP:DURABLE_WRITE_FAILED","SAFE_STOP:SAFE_STOP_LATCHED"]
    },
    {
      "id": "RVM-006-attach-failure-is-unhealthy",
      "frames": [{"event":"STARTUP","attach_ok":false}],
      "expected": ["UNHEALTHY:TERMINAL_ATTACH_FAILED"]
    },
    {
      "id": "RVM-007-network-reconnect-requires-full-probe",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"connected":false},
        {"event":"RECONNECT","sequence":2,"monotonic_ms":3000,"full_probe_ok":false}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:NETWORK_OR_TERMINAL_DISCONNECTED","UNHEALTHY:RECONNECT_REPROBE_INCOMPLETE"]
    },
    {
      "id": "RVM-008-network-reconnect-recovers-after-full-probe",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"connected":false},
        {"event":"RECONNECT","sequence":1,"monotonic_ms":3000,"full_probe_ok":true},
        {"event":"SAMPLE","sequence":2,"monotonic_ms":4000}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:NETWORK_OR_TERMINAL_DISCONNECTED","HEALTHY:OK","HEALTHY:OK"]
    },
    {
      "id": "RVM-009-stale-tick-fails-closed-and-recovers",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"tick_age_ms":30001},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":3000,"tick_age_ms":30000}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:STALE_TICK","HEALTHY:OK"]
    },
    {
      "id": "RVM-010-identity-drift-safe-stops",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"identity":"account-b|server-a|XAUUSD"}
      ],
      "expected": ["HEALTHY:OK","SAFE_STOP:IDENTITY_DRIFT"]
    },
    {
      "id": "RVM-011-symbol-drift-safe-stops",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"identity":"account-a|server-a|XAUUSDm"}
      ],
      "expected": ["HEALTHY:OK","SAFE_STOP:IDENTITY_DRIFT"]
    },
    {
      "id": "RVM-012-multiple-terminals-fail-closed-then-resolve",
      "frames": [
        {"event":"STARTUP","terminal_candidates":2},
        {"event":"STARTUP","terminal_candidates":1,"sequence":0,"monotonic_ms":1000}
      ],
      "expected": ["UNHEALTHY:TERMINAL_SELECTION_AMBIGUOUS","HEALTHY:OK"]
    },
    {
      "id": "RVM-013-clock-offset-boundary-and-recovery",
      "policy": {"max_abs_clock_offset_ms":1000},
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000,"clock_offset_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"clock_offset_ms":-1001},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":3000,"clock_offset_ms":-1000}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:CLOCK_OFFSET_LIMIT_EXCEEDED","HEALTHY:OK"]
    },
    {
      "id": "RVM-014-monotonic-regression-fails-closed",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":999},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:MONOTONIC_TIME_NOT_INCREASING","HEALTHY:OK"]
    },
    {
      "id": "RVM-015-undeclared-process-restart",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","boot_id":"boot-b","sequence":0,"monotonic_ms":100}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:UNDECLARED_PROCESS_RESTART"]
    },
    {
      "id": "RVM-016-process-restart-must-change-boot-id",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"PROCESS_RESTART","boot_id":"boot-a","sequence":0,"monotonic_ms":100}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:RESTART_BOOT_ID_NOT_CHANGED"]
    },
    {
      "id": "RVM-017-process-restart-requires-startup-checks",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"PROCESS_RESTART","boot_id":"boot-b","sequence":0,"monotonic_ms":100,"startup_checks":false}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:RESTART_REPROBE_INCOMPLETE"]
    },
    {
      "id": "RVM-018-process-restart-full-reprobe-recovers",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"PROCESS_RESTART","boot_id":"boot-b","sequence":0,"monotonic_ms":100},
        {"event":"SAMPLE","boot_id":"boot-b","sequence":1,"monotonic_ms":200}
      ],
      "expected": ["HEALTHY:OK","HEALTHY:OK","HEALTHY:OK"]
    },
    {
      "id": "RVM-019-mt5-restart-attach-and-reprobe",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"MT5_RESTART","sequence":1,"monotonic_ms":2000,"attach_ok":false},
        {"event":"MT5_RESTART","sequence":1,"monotonic_ms":3000,"attach_ok":true,"full_probe_ok":true}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:TERMINAL_ATTACH_FAILED","HEALTHY:OK"]
    },
    {
      "id": "RVM-020-windows-restart-needs-new-boot-and-full-probe",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"WINDOWS_RESTART","boot_id":"boot-b","sequence":0,"monotonic_ms":100,"full_probe_ok":false},
        {"event":"WINDOWS_RESTART","boot_id":"boot-b","sequence":0,"monotonic_ms":200,"full_probe_ok":true}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:RESTART_REPROBE_INCOMPLETE","HEALTHY:OK"]
    },
    {
      "id": "RVM-021-build-change-requires-validation-and-reprobe",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"terminal_build":6105},
        {"event":"MT5_RESTART","sequence":1,"monotonic_ms":3000,"terminal_build":6105,"compatibility_validated":true,"full_probe_ok":true},
        {"event":"SAMPLE","sequence":2,"monotonic_ms":4000,"terminal_build":6105}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:BUILD_REVALIDATION_REQUIRED","HEALTHY:OK","HEALTHY:OK"]
    },
    {
      "id": "RVM-022-build-validation-without-reprobe-is-insufficient",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"terminal_build":6105,"compatibility_validated":true}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:BUILD_CHANGE_WITHOUT_REPROBE_BOUNDARY"]
    },
    {
      "id": "RVM-023-observation-gap-is-explicit-not-backfilled",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"SAMPLE","sequence":2,"monotonic_ms":3000},
        {"event":"SAMPLE","sequence":3,"monotonic_ms":4000}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:OBSERVATION_SEQUENCE_GAP","HEALTHY:OK"]
    },
    {
      "id": "RVM-024-future-tick-boundary",
      "policy": {"max_future_tick_ms":2000},
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000,"tick_age_ms":-2000},
        {"event":"SAMPLE","sequence":1,"monotonic_ms":2000,"tick_age_ms":-2001}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:FUTURE_TICK_LIMIT_EXCEEDED"]
    },
    {
      "id": "RVM-025-restart-sequence-must-reset",
      "frames": [
        {"event":"STARTUP","sequence":0,"monotonic_ms":1000},
        {"event":"PROCESS_RESTART","boot_id":"boot-b","sequence":7,"monotonic_ms":100}
      ],
      "expected": ["HEALTHY:OK","UNHEALTHY:RESTART_SEQUENCE_NOT_RESET"]
    }
  ]
}
