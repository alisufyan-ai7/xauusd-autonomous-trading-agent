{
  "register_version": "analyst-field-register-1.0",
  "payload_schema_version": "analyst-runtime-1.0",
  "retention_rule": "HASH_AND_VALIDATION_RESULT_ONLY_UNLESS_SEPARATELY_APPROVED",
  "common_fields": [
    "schema_version", "analysis_id", "snapshot_id", "snapshot_time_utc",
    "instrument_class", "candidate_setup_family", "direction",
    "h4_bar_close_utc", "h1_bar_close_utc", "m15_bar_close_utc",
    "quote_age_ms", "completed_m15_delay_ms", "regime", "spread_state",
    "volatility_state", "session_state", "event_guard_state",
    "new_risk_allowed_locally", "unknown_exposure_present",
    "daily_limit_state", "weekly_limit_state", "drawdown_state",
    "loss_pause_state", "evidence_ids"
  ],
  "families": {
    "TPB": [
      "impulse_origin_price", "impulse_endpoint_price", "active_zone",
      "zone_near_price", "zone_far_price", "independent_location",
      "rejection_extreme_price", "confirmation_extreme_price",
      "first_target_price", "final_target_price", "impulse_qualified",
      "zone_qualified", "confirmation_qualified"
    ],
    "BRT": [
      "breakout_boundary_price", "consolidation_far_boundary_price",
      "consolidation_width_atr_bp", "breakout_close_price",
      "retest_extreme_price", "confirmation_extreme_price",
      "first_target_price", "final_target_price", "breakout_qualified",
      "retest_qualified", "confirmation_qualified"
    ],
    "FBR": [
      "reference_boundary_price", "failed_break_extreme_price",
      "failed_break_depth_atr_bp", "reclaim_close_price",
      "confirmation_extreme_price", "first_target_price", "final_target_price",
      "reclaim_qualified", "hold_qualified", "confirmation_qualified"
    ],
    "RSR": [
      "lower_boundary_price", "upper_boundary_price", "midpoint_price",
      "active_boundary_price", "rejection_extreme_price",
      "confirmation_extreme_price", "distance_from_boundary_range_bp",
      "first_target_price", "final_target_price", "range_qualified",
      "location_qualified", "confirmation_qualified"
    ],
    "MOC": [
      "impulse_origin_price", "impulse_endpoint_price", "compression_low_price",
      "compression_high_price", "trigger_close_price", "first_target_price",
      "final_target_price", "compression_range_atr_bp", "retracement_bp",
      "quote_slippage_atr_bp", "compression_qualified", "trigger_qualified"
    ]
  },
  "field_definitions": {
    "schema_version": {"type":"enum","values":["analyst-runtime-1.0"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":0,"source_class":"LOCAL_CONTRACT","purpose":"bind payload parser","retention":"HASH_ONLY"},
    "analysis_id": {"type":"uuid_v4","unit":"OPAQUE_ID","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_RANDOM","purpose":"bind one response attempt","retention":"HASH_ONLY"},
    "snapshot_id": {"type":"sha256","unit":"OPAQUE_ID","precision":"LOWERCASE_64_HEX","max_age_seconds":30,"source_class":"LOCAL_CANONICAL_HASH","purpose":"bind immutable minimized facts","retention":"HASH_ONLY"},
    "snapshot_time_utc": {"type":"utc","unit":"RFC3339_SECONDS","precision":"1_SECOND","max_age_seconds":30,"source_class":"LOCAL_CLOCK","purpose":"freshness binding","retention":"HASH_ONLY"},
    "instrument_class": {"type":"enum","values":["XAUUSD_GOLD_CFD"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_MAPPING","purpose":"semantic instrument class","retention":"HASH_ONLY"},
    "candidate_setup_family": {"type":"enum","values":["TPB","BRT","FBR","RSR","MOC"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SELECTOR","purpose":"bind one nominated family","retention":"HASH_ONLY"},
    "direction": {"type":"enum","values":["BUY","SELL"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SELECTOR","purpose":"bind nominated direction","retention":"HASH_ONLY"},
    "h4_bar_close_utc": {"type":"utc","unit":"RFC3339_SECONDS","precision":"1_SECOND","max_age_seconds":14400,"source_class":"LOCAL_OHLC_DERIVED","purpose":"bind completed regime bar","retention":"HASH_ONLY"},
    "h1_bar_close_utc": {"type":"utc","unit":"RFC3339_SECONDS","precision":"1_SECOND","max_age_seconds":3600,"source_class":"LOCAL_OHLC_DERIVED","purpose":"bind completed structure bar","retention":"HASH_ONLY"},
    "m15_bar_close_utc": {"type":"utc","unit":"RFC3339_SECONDS","precision":"1_SECOND","max_age_seconds":30,"source_class":"LOCAL_OHLC_DERIVED","purpose":"bind completed trigger bar","retention":"HASH_ONLY"},
    "quote_age_ms": {"type":"integer","minimum":0,"maximum":2000,"unit":"MILLISECONDS","precision":"1_MS","max_age_seconds":2,"source_class":"LOCAL_QUOTE_HEALTH","purpose":"prove quote freshness without price","retention":"HASH_ONLY"},
    "completed_m15_delay_ms": {"type":"integer","minimum":0,"maximum":30000,"unit":"MILLISECONDS","precision":"1_MS","max_age_seconds":30,"source_class":"LOCAL_BAR_HEALTH","purpose":"prove completed bar availability","retention":"HASH_ONLY"},
    "regime": {"type":"enum","values":["UP_TREND","DOWN_TREND","RANGE"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_OHLC_DERIVED","purpose":"family eligibility","retention":"HASH_ONLY"},
    "spread_state": {"type":"enum","values":["NORMAL","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_MARKET_GATE","purpose":"local spread gate","retention":"HASH_ONLY"},
    "volatility_state": {"type":"enum","values":["NORMAL","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_MARKET_GATE","purpose":"local volatility gate","retention":"HASH_ONLY"},
    "session_state": {"type":"enum","values":["OPEN","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SESSION_GATE","purpose":"local session gate","retention":"HASH_ONLY"},
    "event_guard_state": {"type":"enum","values":["HEALTHY","PRE_LOCK","EVENT_ACTIVE","POST_LOCK","NORMALIZATION_PENDING","SHOCK_LOCK","SOURCE_UNHEALTHY"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_EVENT_GUARD","purpose":"scheduled and shock protection","retention":"HASH_ONLY"},
    "new_risk_allowed_locally": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RISK_GATE","purpose":"skip blocked calls","retention":"HASH_ONLY"},
    "unknown_exposure_present": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RECONCILIATION","purpose":"skip unresolved exposure","retention":"HASH_ONLY"},
    "daily_limit_state": {"type":"enum","values":["CLEAR","NEAR_LIMIT","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RISK_GATE","purpose":"coarse daily gate","retention":"HASH_ONLY"},
    "weekly_limit_state": {"type":"enum","values":["CLEAR","NEAR_LIMIT","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RISK_GATE","purpose":"coarse weekly gate","retention":"HASH_ONLY"},
    "drawdown_state": {"type":"enum","values":["CLEAR","NEAR_LIMIT","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RISK_GATE","purpose":"coarse drawdown gate","retention":"HASH_ONLY"},
    "loss_pause_state": {"type":"enum","values":["CLEAR","BLOCKED","UNKNOWN"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":2,"source_class":"LOCAL_RISK_GATE","purpose":"coarse pause gate","retention":"HASH_ONLY"},
    "evidence_ids": {"type":"array_opaque_id","minimum_items":1,"maximum_items":16,"unit":"OPAQUE_ID","precision":"UNIQUE_ASCII_1_TO_32","max_age_seconds":30,"source_class":"LOCAL_FEATURE_REGISTRY","purpose":"bind output evidence references","retention":"HASH_ONLY"},

    "impulse_origin_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_OHLC_DERIVED","purpose":"bind impulse geometry","retention":"HASH_ONLY"},
    "impulse_endpoint_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_OHLC_DERIVED","purpose":"bind impulse geometry","retention":"HASH_ONLY"},
    "active_zone": {"type":"enum","values":["A","B"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind TPB opportunity","retention":"HASH_ONLY"},
    "zone_near_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind TPB zone","retention":"HASH_ONLY"},
    "zone_far_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind TPB zone","retention":"HASH_ONLY"},
    "independent_location": {"type":"enum","values":["H1_EMA20","H1_SWING_LEVEL","BROKEN_CONSOLIDATION_BOUNDARY"],"unit":"TOKEN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"prove non-Fibonacci confluence","retention":"HASH_ONLY"},
    "rejection_extreme_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind rejection geometry","retention":"HASH_ONLY"},
    "confirmation_extreme_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind confirmation geometry","retention":"HASH_ONLY"},
    "first_target_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind structural TP1 candidate","retention":"HASH_ONLY"},
    "final_target_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind structural final target","retention":"HASH_ONLY"},
    "impulse_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind impulse eligibility","retention":"HASH_ONLY"},
    "zone_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind TPB location eligibility","retention":"HASH_ONLY"},
    "confirmation_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind trigger eligibility","retention":"HASH_ONLY"},

    "breakout_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind breakout boundary","retention":"HASH_ONLY"},
    "consolidation_far_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind old consolidation","retention":"HASH_ONLY"},
    "consolidation_width_atr_bp": {"type":"integer","minimum":5000,"maximum":20000,"unit":"ATR_BASIS_POINTS","precision":"1_BP","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind BRT consolidation width","retention":"HASH_ONLY"},
    "breakout_close_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind completed breakout","retention":"HASH_ONLY"},
    "retest_extreme_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind retest geometry","retention":"HASH_ONLY"},
    "breakout_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind breakout eligibility","retention":"HASH_ONLY"},
    "retest_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind retest eligibility","retention":"HASH_ONLY"},

    "reference_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind failed-break boundary","retention":"HASH_ONLY"},
    "failed_break_extreme_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind failed-break extreme","retention":"HASH_ONLY"},
    "failed_break_depth_atr_bp": {"type":"integer","minimum":1000,"maximum":6000,"unit":"ATR_BASIS_POINTS","precision":"1_BP","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind failed-break depth","retention":"HASH_ONLY"},
    "reclaim_close_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind reclaim close","retention":"HASH_ONLY"},
    "reclaim_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind reclaim eligibility","retention":"HASH_ONLY"},
    "hold_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind post-reclaim hold","retention":"HASH_ONLY"},

    "lower_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind range lower boundary","retention":"HASH_ONLY"},
    "upper_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind range upper boundary","retention":"HASH_ONLY"},
    "midpoint_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind range TP1","retention":"HASH_ONLY"},
    "active_boundary_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind traded range boundary","retention":"HASH_ONLY"},
    "distance_from_boundary_range_bp": {"type":"integer","minimum":0,"maximum":1500,"unit":"RANGE_BASIS_POINTS","precision":"1_BP","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind RSR location","retention":"HASH_ONLY"},
    "range_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind range validity","retention":"HASH_ONLY"},
    "location_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind outer-15-percent location","retention":"HASH_ONLY"},

    "compression_low_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind compression low","retention":"HASH_ONLY"},
    "compression_high_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind compression high","retention":"HASH_ONLY"},
    "trigger_close_price": {"type":"decimal_string","minimum":"0.001","maximum":"99999.99999","unit":"XAUUSD_PRICE","precision":"MAX_5_DECIMALS","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind completed momentum trigger","retention":"HASH_ONLY"},
    "compression_range_atr_bp": {"type":"integer","minimum":0,"maximum":7500,"unit":"ATR_BASIS_POINTS","precision":"1_BP","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind compression width","retention":"HASH_ONLY"},
    "retracement_bp": {"type":"integer","minimum":0,"maximum":3820,"unit":"IMPULSE_BASIS_POINTS","precision":"1_BP","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind MOC retracement","retention":"HASH_ONLY"},
    "quote_slippage_atr_bp": {"type":"integer","minimum":0,"maximum":1500,"unit":"ATR_BASIS_POINTS","precision":"1_BP","max_age_seconds":2,"source_class":"LOCAL_QUOTE_HEALTH","purpose":"bind no-chase limit","retention":"HASH_ONLY"},
    "compression_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind MOC compression eligibility","retention":"HASH_ONLY"},
    "trigger_qualified": {"type":"boolean","unit":"BOOLEAN","precision":"EXACT","max_age_seconds":30,"source_class":"LOCAL_SETUP_ORACLE","purpose":"bind MOC trigger eligibility","retention":"HASH_ONLY"}
