{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xauusd-agent:gate1-release-manifest:1.0",
  "title": "Gate 1 release manifest planning schema",
  "description": "Documentation-only schema derived from the frozen release identity fields. It is not a release, gate result or implementation authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "application_version",
    "source_commit_sha",
    "source_tree_sha",
    "artifact_sha256",
    "dependency_lock_sha256",
    "dependency_hashes_sha256",
    "python_version",
    "python_architecture",
    "target_os",
    "mt5_terminal_build",
    "database_schema_version",
    "database_migration_root_sha256",
    "model_snapshot",
    "analyst_profile_sha256",
    "prompt_sha256",
    "config_sha256",
    "requirements_test_matrix_sha256",
    "golden_report_sha256",
    "property_report_sha256",
    "mutation_report_sha256",
    "cross_platform_report_sha256",
    "deployment_off_report_sha256",
    "rollback_report_sha256",
    "analysis_enabled_default",
    "execution_enabled_default",
    "external_python_trading_required_state",
    "trading_authorized",
    "created_utc"
  ],
  "properties": {
    "schema_version": {"const": "gate1-release-manifest-1.0"},
    "application_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "source_commit_sha": {"$ref": "#/$defs/git_sha"},
    "source_tree_sha": {"$ref": "#/$defs/git_sha"},
    "artifact_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "dependency_hashes_sha256": {"$ref": "#/$defs/sha256"},
    "python_version": {"type": "string", "pattern": "^3\\.12(?:\\.[0-9]+)?$"},
    "python_architecture": {"enum": ["x86_64", "amd64"]},
    "target_os": {"enum": ["windows-server", "linux-ci"]},
    "mt5_terminal_build": {"type": ["integer", "string"], "minLength": 1},
    "database_schema_version": {"type": "string", "minLength": 1, "maxLength": 64},
    "database_migration_root_sha256": {"$ref": "#/$defs/sha256"},
    "model_snapshot": {"type": "string", "minLength": 1, "maxLength": 128},
    "analyst_profile_sha256": {"$ref": "#/$defs/sha256"},
    "prompt_sha256": {"$ref": "#/$defs/sha256"},
    "config_sha256": {"$ref": "#/$defs/sha256"},
    "requirements_test_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "golden_report_sha256": {"$ref": "#/$defs/sha256"},
    "property_report_sha256": {"$ref": "#/$defs/sha256"},
    "mutation_report_sha256": {"$ref": "#/$defs/sha256"},
    "cross_platform_report_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_off_report_sha256": {"$ref": "#/$defs/sha256"},
    "rollback_report_sha256": {"$ref": "#/$defs/sha256"},
    "analysis_enabled_default": {"type": "boolean"},
    "execution_enabled_default": {"const": false},
    "external_python_trading_required_state": {"const": "DISABLED"},
    "trading_authorized": {"const": false},
    "created_utc": {"type": "string", "format": "date-time"},
    "claim_limit": {
      "const": "Gate 1 deterministic implementation evidence only; no broker, demo/live or trading authority."
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
  }
}
