{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xauusd-agent:gate2-fault-scenario:1.0",
  "title": "Gate 2 simulated fault scenario planning schema",
  "description": "Defines evidence for a simulated fault bound to the future Gate 1 artifact. It does not authorize a real VPS fault, broker connection or trading action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scenario_id",
    "requirement_refs",
    "gate1_release_manifest_sha256",
    "fault_family",
    "fault_fixture_sha256",
    "deterministic_seed",
    "initial_state",
    "input_event_trace_sha256",
    "expected_state_trace",
    "expected_terminal_state",
    "expected_reason_codes",
    "observed_state_trace",
    "observed_terminal_state",
    "observed_reason_codes",
    "risk_increasing_action_count",
    "external_action_count",
    "real_broker_connected",
    "execution_enabled",
    "audit_trace_sha256",
    "result",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "gate2-fault-scenario-1.0"},
    "scenario_id": {"type": "string", "pattern": "^G2-[A-Z0-9][A-Z0-9_-]{2,63}$"},
    "requirement_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "gate1_release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "fault_family": {
      "enum": [
        "STATE_SEQUENCE",
        "SUBMISSION_RECONCILIATION",
        "STORE_CRASH_CONCURRENCY",
        "IDENTITY_DRIFT",
        "TIME_CLOCK",
        "MARKET_DATA",
        "RISK_MATH",
        "EVENT_SESSION_SHOCK",
        "ANALYST_PROTOCOL",
        "SERVICE_SUPERVISION",
        "EVIDENCE_INTEGRITY"
      ]
    },
    "fault_fixture_sha256": {"$ref": "#/$defs/sha256"},
    "deterministic_seed": {"type": "integer", "minimum": 0},
    "initial_state": {"type": "string", "minLength": 1},
    "input_event_trace_sha256": {"$ref": "#/$defs/sha256"},
    "expected_state_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "expected_terminal_state": {"type": "string", "minLength": 1},
    "expected_reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "observed_state_trace": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "observed_terminal_state": {"type": "string", "minLength": 1},
    "observed_reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "risk_increasing_action_count": {"const": 0},
    "external_action_count": {"const": 0},
    "real_broker_connected": {"const": false},
    "execution_enabled": {"const": false},
    "audit_trace_sha256": {"$ref": "#/$defs/sha256"},
    "property_case": {"type": "boolean"},
    "mutation_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "mutation_survived": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
    "result": {"enum": ["PASS", "FAIL"]},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "claim_limit": {"const": "Simulated Gate 2 evidence only; no external fault, broker or trading authority."}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
