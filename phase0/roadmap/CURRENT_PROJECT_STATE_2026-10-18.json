        "ONE_TERMINAL64_OS_PROCESS_PID_PATH_START_TIME",
        "STAGED_MANIFEST_SHA256",
        "FIVE_STAGED_COMPONENT_SHA256",
        "EXECUTION_OFF_STAGE_MARKER",
        "EXISTENCE_OF_PINNED_PYTHON_EXE"
      ],
      "does_not": [
        "IMPORT_OR_INITIALIZE_MT5",
        "BROKER_READ_OR_TICK_CAPTURE",
        "ORDER_CHECK_OR_SEND",
        "TOGGLE_EXTERNAL_PYTHON",
        "CREATE_OR_DELETE_FILES",
        "CHANGE_TASKS_OR_SETTINGS"
      ],
      "owner_output_received": false,
      "owner_approval_received": false
    }
  }
}
