{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xauusd-agent:gate3-trial-registry-entry:1.0",
  "title": "Gate 3 immutable trial registry entry planning schema",
  "description": "Captures every replay research trial and its influence. It does not register or open a holdout by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "trial_id",
    "registered_utc",
    "hypothesis",
    "family_version",
    "author_or_tool",
    "parent_trial_ids",
    "search_method",
    "parameter_domain_sha256",
    "selected_parameters_sha256",
    "random_seed",
    "dataset_bundle_root_sha256",
    "split_map_sha256",
    "partition",
    "purge_embargo_sha256",
    "release_manifest_sha256",
    "feature_setup_config_sha256",
    "cost_fill_model_sha256",
    "acceptance_rule_sha256",
    "selection_adjustment_sha256",
    "status",
    "compute_result_sha256",
    "exclusions",
    "influenced_later_choices",
    "holdout_accessed",
    "trading_authorized",
    "record_prev_sha256",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "gate3-trial-registry-entry-1.0"},
    "trial_id": {"type": "string", "pattern": "^G3-TRIAL-[A-Z0-9][A-Z0-9_-]{2,95}$"},
    "registered_utc": {"type": "string", "format": "date-time"},
    "hypothesis": {"type": "string", "minLength": 1, "maxLength": 4096},
    "family_version": {"type": "string", "minLength": 1, "maxLength": 128},
    "author_or_tool": {"type": "string", "minLength": 1, "maxLength": 256},
    "parent_trial_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "search_method": {"enum": ["FIXED_CANDIDATE", "GRID", "RANDOM", "WALK_FORWARD", "MANUAL", "AI_SUGGESTED", "ROBUSTNESS_ONLY"]},
    "parameter_domain_sha256": {"$ref": "#/$defs/sha256"},
    "selected_parameters_sha256": {"$ref": "#/$defs/sha256"},
    "random_seed": {"type": "integer", "minimum": 0},
    "dataset_bundle_root_sha256": {"$ref": "#/$defs/sha256"},
    "split_map_sha256": {"$ref": "#/$defs/sha256"},
    "partition": {"enum": ["DEVELOPMENT", "VALIDATION", "WALK_FORWARD_OOS", "HOLDOUT", "ROBUSTNESS"]},
    "purge_embargo_sha256": {"$ref": "#/$defs/sha256"},
    "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "feature_setup_config_sha256": {"$ref": "#/$defs/sha256"},
    "cost_fill_model_sha256": {"$ref": "#/$defs/sha256"},
    "acceptance_rule_sha256": {"$ref": "#/$defs/sha256"},
    "selection_adjustment_sha256": {"$ref": "#/$defs/sha256"},
    "candidate_seal_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "holdout_opening_receipt_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "status": {"enum": ["REGISTERED_NOT_RUN", "RUNNING", "COMPLETED", "FAILED", "ABANDONED", "INVALIDATED"]},
    "compute_result_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "exclusions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_sha256", "reason_code"],
        "properties": {
          "item_sha256": {"$ref": "#/$defs/sha256"},
          "reason_code": {"type": "string", "minLength": 1}
        }
      }
    },
    "influenced_later_choices": {"type": "boolean"},
    "holdout_accessed": {"type": "boolean"},
    "deviation_record_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "trading_authorized": {"const": false},
    "record_prev_sha256": {"$ref": "#/$defs/sha256"},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "claim_limit": {"const": "Historical replay research only; no shadow, broker or trading authority."}
  },
  "allOf": [
    {
      "if": {"properties": {"partition": {"const": "HOLDOUT"}}},
      "then": {
        "required": ["candidate_seal_sha256", "holdout_opening_receipt_sha256"],
        "properties": {
          "candidate_seal_sha256": {"$ref": "#/$defs/sha256"},
          "holdout_opening_receipt_sha256": {"$ref": "#/$defs/sha256"},
          "holdout_accessed": {"const": true}
        }
      }
    },
    {
      "if": {"properties": {"partition": {"not": {"const": "HOLDOUT"}}}},
      "then": {"properties": {"holdout_accessed": {"const": false}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
