{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xauusd-agent:gate4-observation-registration:1.0",
  "title": "Gate 4 live-shadow observation registration planning schema",
  "description": "Freezes the shadow observation identity and coverage before start. It does not start Gate 4 or authorize an external connection or order capability.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registered_utc",
    "gate1_pass_receipt_sha256",
    "gate2_pass_receipt_sha256",
    "gate3_pass_receipt_sha256",
    "release_manifest_sha256",
    "account_symbol_fingerprint_sha256",
    "start_rule_sha256",
    "full_market_month_definition_sha256",
    "required_event_coverage_inventory_sha256",
    "required_session_holiday_inventory_sha256",
    "required_regime_inventory_sha256",
    "expected_decision_schedule_sha256",
    "allowed_gap_policy_sha256",
    "replay_live_feature_tolerance_sha256",
    "monitoring_thresholds_sha256",
    "incident_policy_sha256",
    "change_continuation_policy_sha256",
    "deployment_off_report_sha256",
    "rollback_report_sha256",
    "execution_capability_present",
    "execution_enabled",
    "broker_action_count_at_registration",
    "status",
    "record_sha256"
  ],
  "properties": {
    "schema_version": {"const": "gate4-observation-registration-1.0"},
    "registered_utc": {"type": "string", "format": "date-time"},
    "gate1_pass_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "gate2_pass_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "gate3_pass_receipt_sha256": {"$ref": "#/$defs/sha256"},
    "release_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "account_symbol_fingerprint_sha256": {"$ref": "#/$defs/sha256"},
    "start_rule_sha256": {"$ref": "#/$defs/sha256"},
    "full_market_month_definition_sha256": {"$ref": "#/$defs/sha256"},
    "required_event_coverage_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "required_session_holiday_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "required_regime_inventory_sha256": {"$ref": "#/$defs/sha256"},
    "expected_decision_schedule_sha256": {"$ref": "#/$defs/sha256"},
    "allowed_gap_policy_sha256": {"$ref": "#/$defs/sha256"},
    "replay_live_feature_tolerance_sha256": {"$ref": "#/$defs/sha256"},
    "monitoring_thresholds_sha256": {"$ref": "#/$defs/sha256"},
    "incident_policy_sha256": {"$ref": "#/$defs/sha256"},
    "change_continuation_policy_sha256": {"$ref": "#/$defs/sha256"},
    "deployment_off_report_sha256": {"$ref": "#/$defs/sha256"},
    "rollback_report_sha256": {"$ref": "#/$defs/sha256"},
    "observation_start_utc": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "execution_capability_present": {"const": false},
    "execution_enabled": {"const": false},
    "broker_action_count_at_registration": {"const": 0},
    "status": {"enum": ["REGISTERED_NOT_STARTED", "STARTED", "INVALIDATED"]},
    "invalidation_reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "record_sha256": {"$ref": "#/$defs/sha256"},
    "claim_limit": {"const": "Gate 4 shadow registration only; no execution, broker mutation or trading authority."}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "REGISTERED_NOT_STARTED"}}},
      "then": {"properties": {"observation_start_utc": {"type": "null"}}}
    },
    {
      "if": {"properties": {"status": {"const": "STARTED"}}},
      "then": {
        "required": ["observation_start_utc"],
        "properties": {"observation_start_utc": {"type": "string", "format": "date-time"}}
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
