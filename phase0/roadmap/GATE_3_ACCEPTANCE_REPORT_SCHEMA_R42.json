{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:xauusd-agent:gate3-acceptance-report:1.0",
  "title": "Gate 3 registered replay acceptance report planning schema",
  "description": "Machine-readable shape for the already-frozen Gate 3 procedure. It opens no dataset or holdout and supplies no gate credit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "registration_sha256", "release_manifest_sha256", "bundle_root_sha256", "split_map_sha256",
    "trial_registry_root_sha256", "holdout_opening_receipt_sha256", "deterministic_repeat", "leakage_audit",
    "invalid_or_silently_dropped_events", "policy_violations", "all_trials_reported", "family_results",
    "robustness_result", "verdict", "trading_authorized"
  ],
  "properties": {
    "schema_version": {"const":"gate3-acceptance-1.0"},
    "registration_sha256": {"$ref":"#/$defs/sha256"},
    "release_manifest_sha256": {"$ref":"#/$defs/sha256"},
    "bundle_root_sha256": {"$ref":"#/$defs/sha256"},
    "split_map_sha256": {"$ref":"#/$defs/sha256"},
    "trial_registry_root_sha256": {"$ref":"#/$defs/sha256"},
    "holdout_opening_receipt_sha256": {"$ref":"#/$defs/sha256"},
    "candidate_seal_sha256": {"$ref":"#/$defs/sha256"},
    "acceptance_rule_sha256": {"$ref":"#/$defs/sha256"},
    "statistics_plan_sha256": {"$ref":"#/$defs/sha256"},
    "stress_plan_sha256": {"$ref":"#/$defs/sha256"},
    "deterministic_repeat": {"enum":["PASS","FAIL"]},
    "leakage_audit": {"enum":["PASS","FAIL"]},
    "replay_live_feature_reconciliation": {"enum":["PASS","FAIL"]},
    "invalid_or_silently_dropped_events": {"const":0},
    "policy_violations": {"type":"integer","minimum":0},
    "all_trials_reported": {"type":"boolean"},
    "family_results": {
      "type":"array",
      "items": {
        "type":"object",
        "additionalProperties":false,
        "required":["family_id","sample_count","net_expectancy_r","interval_95_lower_r","selection_result","concentration_result","walk_forward_result","cost_sensitivity_result","verdict"],
        "properties": {
          "family_id":{"type":"string","minLength":1,"maxLength":64},
          "sample_count":{"type":"integer","minimum":0},
          "coverage_justification_sha256":{"$ref":"#/$defs/sha256"},
          "net_expectancy_r":{"type":"number"},
          "interval_95_lower_r":{"type":"number"},
          "bootstrap_resamples":{"type":"integer","minimum":0},
          "dsr_probability":{"type":["number","null"],"minimum":0,"maximum":1},
          "pbo":{"type":["number","null"],"minimum":0,"maximum":1},
          "selection_substitute_sha256":{"oneOf":[{"$ref":"#/$defs/sha256"},{"type":"null"}]},
          "selection_result":{"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
          "policy_path_result":{"enum":["PASS","FAIL"]},
          "max_positive_month_profit_share":{"type":["number","null"],"minimum":0,"maximum":1},
          "max_utc_session_profit_share":{"type":["number","null"],"minimum":0,"maximum":1},
          "expectancy_excluding_best_five_r":{"type":["number","null"]},
          "concentration_result":{"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
          "non_negative_oos_fold_share":{"type":["number","null"],"minimum":0,"maximum":1},
          "expectancy_excluding_best_fold_r":{"type":["number","null"]},
          "walk_forward_result":{"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
          "double_variable_cost_expectancy_r":{"type":["number","null"]},
          "cost_sensitivity_result":{"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
          "verdict":{"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]}
        }
      }
    },
    "portfolio_result": {"type":["object","null"]},
    "robustness_result": {"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
    "verdict": {"enum":["PASS","FAIL","INSUFFICIENT_EVIDENCE"]},
    "trading_authorized": {"const":false},
    "record_sha256": {"$ref":"#/$defs/sha256"}
  },
  "$defs": {
    "sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}
  },
  "x-frozen-acceptance-procedure": {
    "validity_gates": ["lineage", "causal/leakage audit", "deterministic repeat", "complete trial accounting", "replay/live feature reconciliation", "zero policy violations", "zero invalid or silently dropped events"],
    "primary": "OOS net expectancy per initial planned risk R is positive.",
    "uncertainty": "Two-sided 95% interval lower bound is greater than -0.05R and the point estimate remains positive; use the predeclared dependence-aware bootstrap with at least 10,000 resamples or a preregistered conservative substitute.",
    "sample": "Sample and coverage are prospectively justified; sparse results are INSUFFICIENT_EVIDENCE.",
    "selection": "DSR probability >= 0.95 and PBO <= 0.20 where applicable, otherwise the preregistered selection-aware substitute must pass.",
    "policy_path": "Base and stress drawdown/loss-streak/day/week paths remain inside Policy A.",
    "concentration": "No month supplies more than 50% of positive-month profit; no UTC session bucket more than 60%; expectancy excluding the best five trades remains > -0.05R.",
    "walk_forward": "At least 75% of completed OOS folds have non-negative expectancy; aggregate excluding the best fold remains > -0.05R.",
    "cost_sensitivity": "Doubling modeled variable transaction costs leaves OOS expectancy > -0.05R.",
    "robustness": "No risk-rule violation, drawdown beyond the approved ceiling or operational inconsistency under the frozen stress suite; profit under every stress is not required."
  },
  "x-current-state": {
    "schema_prepared_only": true,
    "gate3_started": false,
    "trial_run": false,
    "holdout_opened": false,
    "R4_opened": false,
    "gate_credit": false,
    "external_python_trading_required_state": "DISABLED"
  }
}
